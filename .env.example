# strate reads these from the process environment when it starts (it does not
# load a .env file). All are optional.

# Claude Code config dir to watch. Default: ~/.claude
CLAUDE_CONFIG_DIR=

# Opt in to the http hook receiver on 127.0.0.1 at this port (1-65535).
# Unset or empty leaves it off. The README's hook snippet uses 47615.
STRATE_HOOK_PORT=

# Bearer token every hook request must carry. Set the same variable where
# Claude Code runs so its hook headers can send it. Unset accepts any local POST.
STRATE_HOOK_TOKEN=

# Store file. Default: strate-dev.db in debug builds, strate.db in release
# builds, both in the app data dir. Must be an absolute path to a file in an
# existing directory; anything else fails startup.
STRATE_DB=
